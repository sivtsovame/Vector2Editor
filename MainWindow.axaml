<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VectorEditor.MainWindow"
        Width="900" Height="600"
        Background="#20232A"
        Title="VectorEditor — видно!">
  <Grid RowDefinitions="Auto,Auto,*">
    <!-- ШАПКА -->
    <Border Grid.Row="0"
            Background="#61DAFB"
            Padding="12">
      <TextBlock Text="VECTOR EDITOR"
                 FontSize="24"
                 FontWeight="Bold"
                 Foreground="#20232A" />
    </Border>

    <!-- СТРОКА КНОПОК -->
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Spacing="8"
                Margin="12,4,12,0">

      <!-- 1. отмена / повтор -->
      <Button Content="Отменить" Click="OnUndo"
              Background="White" Foreground="Black"/>
      <Button Content="Вернуть" Click="OnRedo"
              Background="White" Foreground="Black"/>

      <!-- 2. отдельная кнопка выбора -->
      <Button Content="Выделить" Click="OnSelectToolClicked"
              Background="White" Foreground="Black"/>

      <!-- 3. раскрывающиеся разделы -->
      <Button Content="Фигуры" Click="OnShowShapes"
              Background="White" Foreground="Black"/>
      <Button Content="Контур" Click="OnShowStroke"
              Background="White" Foreground="Black"/>
      <Button Content="Заливка" Click="OnShowFill"
              Background="White" Foreground="Black"/>
      <Button Content="Толщина" Click="OnShowThickness"
              Background="White" Foreground="Black"/>
    </StackPanel>

    <!-- СТРОКА НАСТРОЕК (одна из панелей) -->
    <Grid Grid.Row="2" RowDefinitions="Auto,*">
      <!-- тут мы будем показывать одну панель -->
      <StackPanel x:Name="OptionsHost"
                  Orientation="Horizontal"
                  Spacing="6"
                  Margin="12,6,12,6">
        <!-- по умолчанию пусто -->
      </StackPanel>

      <!-- ХОЛСТ -->
      <Border Grid.Row="1"
              Margin="12"
              Background="#888"
              CornerRadius="6"
              Padding="6">
        <Canvas Background="White"
                PointerPressed="OnCanvasPointerPressed"
                PointerMoved="OnCanvasPointerMoved"
                PointerReleased="OnCanvasPointerReleased" />
      </Border>
    </Grid>
  </Grid>
</Window>
