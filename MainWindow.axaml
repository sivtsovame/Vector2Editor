<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VectorEditor.MainWindow"
        Width="900" Height="600"
        Background="#20232A"
        Title="VectorEditor">
  <Grid RowDefinitions="Auto,*">
    <!-- Верхняя панель инструментов -->
    <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Spacing="8"
                Margin="12,10,12,6">
      <Button x:Name="OpenBtn"    Content="Открыть"        Background="White" Foreground="Black"/>
      <Button x:Name="SaveBtn"    Content="Сохранить"      Background="White" Foreground="Black"/>
      <Button x:Name="SaveAsBtn"  Content="Сохранить как"  Background="White" Foreground="Black"/>

      <TextBlock Text=" | " Foreground="#AAA" VerticalAlignment="Center"/>

      <Button x:Name="UndoBtn"    Content="Отменить"       Background="White" Foreground="Black"/>
      <Button x:Name="RedoBtn"    Content="Повторить"      Background="White" Foreground="Black"/>

      <TextBlock Text=" | " Foreground="#AAA" VerticalAlignment="Center"/>

      <Button x:Name="SelectBtn"  Content="Выделить"       Background="White" Foreground="Black"/>
      <Button x:Name="DeleteBtn"  Content="Удалить"        Background="White" Foreground="Black"/>

      <TextBlock Text=" | " Foreground="#AAA" VerticalAlignment="Center"/>

      <Button x:Name="ShapesBtn"  Content="Фигуры"         Background="White" Foreground="Black"/>
      <Button x:Name="StrokeBtn"  Content="Контур"         Background="White" Foreground="Black"/>
      <Button x:Name="FillBtn"    Content="Заливка"        Background="White" Foreground="Black"/>
      <Button x:Name="ThickBtn"   Content="Толщина"        Background="White" Foreground="Black"/>

      <TextBlock Text=" | " Foreground="#AAA" VerticalAlignment="Center"/>

      <Button x:Name="ZoomOutBtn" Content="Зум –"          Background="White" Foreground="Black"/>
      <Button x:Name="ZoomInBtn"  Content="Зум +"          Background="White" Foreground="Black"/>
      <Button x:Name="Zoom100Btn" Content="100%"           Background="White" Foreground="Black"/>

      <TextBlock Text="  Масштаб:" Foreground="#DDD" VerticalAlignment="Center" Margin="8,0,0,0"/>
      <TextBlock x:Name="ZoomPercent" Text="100%" Foreground="White"
                 Margin="4,0,0,0" VerticalAlignment="Center"/>
      <Slider x:Name="ZoomSlider" Width="140" Minimum="25" Maximum="400" Value="100"
              Margin="6,0,0,0" VerticalAlignment="Center"/>

      <TextBlock Text=" | " Foreground="#AAA" VerticalAlignment="Center" Margin="8,0,0,0"/>
      <Button x:Name="ExportSvgBtn" Content="Экспорт SVG"  Background="White" Foreground="Black"/>
    </StackPanel>

    <!-- Опции + холст -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*" ClipToBounds="True">
      <!-- Динамическая панель опций -->
      <StackPanel x:Name="OptionsHost"
                  Orientation="Horizontal"
                  Spacing="6"
                  Margin="12,6,12,6" />

      <!-- Холст c серой рамкой -->
      <Border x:Name="CanvasHost"
              Grid.Row="1"
              Margin="12"
              Background="#888"
              CornerRadius="6"
              Padding="6">
        <Canvas x:Name="DrawCanvas" Background="White"/>
      </Border>
    </Grid>
  </Grid>
</Window>
